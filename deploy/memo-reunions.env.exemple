# Copier vers /etc/memo-reunions.env (chmod 600) et adapter.
REUNIONS_DB=/var/lib/memo-reunions/reunions.db
REUNIONS_HOST=0.0.0.0
REUNIONS_PORT=8080
REUNIONS_URL=http://srv-memo.tipiak.local:8080

# Authentification (recommandée dès que l'outil est accessible depuis le réseau)
REUNIONS_UTILISATEUR=admin
REUNIONS_MOT_DE_PASSE=changez-moi
# Jeton permettant à Outlook de lire /actions.ics?jeton=... sans mot de passe
REUNIONS_JETON_ICS=une-longue-chaine-aleatoire

# Récapitulatif e-mail (rappel.py)
SMTP_HOST=relais-smtp.tipiak.local
SMTP_PORT=25
SMTP_STARTTLS=0
RAPPEL_DE=memo-reunions@tipiak.fr
RAPPEL_A=prenom.nom@tipiak.fr
